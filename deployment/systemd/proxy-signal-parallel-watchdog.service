[Unit]
Description=ProxySignal parallel external heartbeat (no automatic remediation)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/proxy-signal-parallel/watchdog.py --ssh-host ger1.censor-amoroso.com --ssh-port 52222 --ssh-user kuma-push --ssh-key-file /etc/proxy-signal-parallel/ssh/id_ed25519 --ssh-known-hosts-file /etc/proxy-signal-parallel/ssh/known_hosts
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
